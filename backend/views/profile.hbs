<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | Prep4Int</title>
    <link rel="stylesheet" href="/css/prep4int.css?v=avatar-contained-20261102">
    <link rel="stylesheet" href="/css/profile.css?v=profile-clean-20261102">
    
    <link rel="icon" href="/img/fevi.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="profile-page">
    <nav>
        <ul>
            <li class="brand">
                <a class="brand-link" href="/index" aria-label="Prep4Int Home">
                    <img src="/img/logo.png" alt="Prep4Int logo">
                    <span>Prep4Int</span>
                </a>
            </li>
            <div class="navi" aria-label="Main navigation">
                <a class="main-nav-link" href="/index"><i class="fa-solid fa-house"></i><span>Home</span></a>
                <a class="main-nav-link" href="/alltopics.html"><i class="fa-solid fa-layer-group"></i><span>Topics</span></a>
                <a class="main-nav-link" href="/rec.html"><i class="fa-solid fa-book-open"></i><span>Recommendations</span></a>
                <a class="main-nav-link" href="/que.html"><i class="fa-solid fa-code"></i><span>Practice Questions</span></a>
                <a class="main-nav-link" href="/index#contactus"><i class="fa-solid fa-envelope"></i><span>Contact Us</span></a>
            </div>
            
                    <li class="account-menu">
                <button class="account-menu-trigger" type="button" aria-expanded="false" aria-controls="account-dropdown">
                    <span class="account-avatar"><i class="fa-solid fa-user"></i></span>
                    <span class="account-trigger-name" id="account-trigger-name">Account</span>
                    <i class="fa-solid fa-chevron-down account-chevron"></i>
                </button>
                <ul class="account-dropdown" id="account-dropdown" hidden>
                    <li class="account-menu-header">
                        <span class="account-avatar account-avatar-large"><i class="fa-solid fa-user"></i></span>
                        <span><strong id="account-fullname">Your account</strong><small id="account-username">@username</small></span>
                    </li>
                    <li class="account-menu-divider" aria-hidden="true"></li>
                    <li><a href="/profile"><i class="fa-solid fa-user-pen"></i> My Profile</a></li>
                    <li><a href="/profile#account-settings"><i class="fa-solid fa-gear"></i> Account Settings</a></li>
                    <li><a href="/profile#dsa-progress"><i class="fa-solid fa-chart-simple"></i> My DSA Progress</a></li>
                    <li class="account-menu-divider" aria-hidden="true"></li>
                    <li><a class="account-logout" href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Log Out</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <main class="profile-wrap">
        <header class="profile-heading">
            <h1 class="profile-title">My Profile</h1>
            <p>Manage your account and track your DSA progress.</p>
        </header>

        <section class="profile-card profile-intro">
            <div class="profile-avatar-wrap">
                <div class="profile-avatar profile-avatar-photo" id="profile-avatar">
                    <i class="fa-solid fa-user" id="profile-avatar-icon"></i>
                    <img id="profile-photo-preview" alt="Your profile photo" hidden>
                </div>
                <button class="profile-photo-edit" id="profile-photo-trigger" type="button" aria-label="Change profile photo" title="Change profile photo">
                    <i class="fa-solid fa-camera"></i>
                </button>
                <button class="profile-photo-remove" id="remove-profile-photo" type="button" aria-label="Remove profile photo" title="Remove profile photo" hidden>
                    <i class="fa-solid fa-trash"></i>
                </button>
                <input id="profile-photo-input" type="file" accept="image/jpeg,image/png,image/webp" hidden>
            </div>
            <div class="profile-identity">
                <h2>{{user.fullname}}</h2>
                <div class="profile-meta">
                    <p class="profile-meta-item"><i class="fa-solid fa-at"></i><span id="profile-username">{{user.username}}</span></p>
                    <p class="profile-meta-item"><i class="fa-solid fa-envelope"></i><span>{{user.email}}</span></p>
                </div>
                <p id="photo-feedback" class="profile-feedback" role="status"></p>
            </div>
            <a class="profile-link" href="/index">Go to Home</a>
        </section>

        <section class="profile-section" id="dsa-progress">
            <div class="profile-section-heading">
                <h2>DSA Progress</h2>
                <a href="/que.html">Practice Questions <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="profile-stats">
                <article class="profile-card profile-stat">
                    <p>Solved</p><strong id="solved-count">—</strong>
                </article>
                <article class="profile-card profile-stat">
                    <p>Total Questions</p><strong id="total-count">—</strong>
                </article>
                <article class="profile-card profile-stat">
                    <p>Remaining</p><strong id="remaining-count">—</strong>
                </article>
            </div>
            <article class="profile-card profile-panel">
                <div class="profile-progress-heading">
                    <h3>Overall Completion</h3>
                    <strong id="progress-percent">0%</strong>
                </div>
                <p id="progress-caption">Loading your progress…</p>
                <div class="profile-track"><div id="overall-progress" class="profile-fill"></div></div>
            </article>
            <article class="profile-card profile-panel">
                <h3>Topic-wise Progress</h3>
                <p class="profile-help">Your solved questions in each topic.</p>
                <div id="topic-progress" class="profile-topic-grid"><span>Loading topics…</span></div>
            </article>
            <p id="progress-error" class="profile-feedback" role="status"></p>
        </section>

        <section class="profile-section" id="account-settings">
            <h2 class="profile-section-title">Account Settings</h2>
            <div class="profile-settings">
                <article class="profile-card profile-setting">
                    <h3><i class="fa-solid fa-user-pen"></i> Change Username</h3>
                    <p class="profile-help">Choose a unique username for your account.</p>
                    <form id="username-form">
                        <label for="new-username">New username</label>
                        <input id="new-username" type="text" minlength="3" maxlength="30" pattern="[A-Za-z0-9_-]{3,30}" value="{{user.username}}" required>
                        <small>3–30 characters: letters, numbers, _ and -</small>
                        <button type="submit">Save Username</button>
                        <p id="username-feedback" class="profile-feedback" role="status"></p>
                    </form>
                </article>
                <article class="profile-card profile-setting">
                    <h3><i class="fa-solid fa-lock"></i> Change Password</h3>
                    <p class="profile-help">Enter your current password to set a new one.</p>
                    <form id="password-form">
                        <label for="current-password">Current password</label>
                        <input id="current-password" type="password" maxlength="128" autocomplete="current-password" required>
                        <label for="new-password">New password</label>
                        <input id="new-password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
                        <label for="confirm-password">Confirm new password</label>
                        <input id="confirm-password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
                        <small>Use 12–128 characters.</small>
                        <button type="submit">Update Password</button>
                        <p id="password-feedback" class="profile-feedback" role="status"></p>
                    </form>
                </article>
            </div>
        </section>
        <footer class="profile-footer">Prep4Int · Keep learning, keep improving.</footer>
    </main>
    <script src="/js/profile.js" defer></script>
    <script src="/js/account-menu.js" defer></script>
</body>
</html>