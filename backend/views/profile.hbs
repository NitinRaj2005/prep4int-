<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | Prep4Int</title>
    <link rel="stylesheet" href="/css/prep4int.css">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/img/fevi.png">
</head>
<body class="profile-page">
    <nav>
        <ul>
            <li class="brand"><img src="/img/logo.png" alt="prep4int"> Prep4Int</li>
            <div class="navi">
                <li class="nav1"><a href="/index#about">About</a></li>
                <li class="nav1"><a href="/index#practise">Practice</a></li>
                <li class="nav1"><a href="/index#contactus">ContactUs</a></li>
            </div>
            <li class="lioful">
                <a class="insta" href="#"><i class="fa fa-bars"></i></a>
                <ul class="dropdown">
                    <li><a href="/index">Home</a></li>
                    <li><a href="/alltopics.html">Topics</a></li>
                    <li><a href="/rec.html">Recomm.</a></li>
                    <li><a href="/que.html">Questions</a></li>
                    <li><a href="/profile">My Profile</a></li>
                    <li><a href="/logout">Log Out</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <main class="profile-wrap">
        <header class="profile-heading">
            <h1 class="profile-title">My Profile</h1>
            <p>Manage your account and track your DSA progress.</p>
        </header>

        <section class="profile-card profile-intro">
            <div class="profile-avatar"><i class="fa-solid fa-user"></i></div>
            <div class="profile-identity">
                <h2>{{user.fullname}}</h2>
                <p>@<span id="profile-username">{{user.username}}</span> · {{user.email}}</p>
            </div>
            <a class="profile-link" href="/index">Go to Home</a>
        </section>

        <section class="profile-section">
            <div class="profile-section-heading">
                <h2>DSA Progress</h2>
                <a href="/que.html">Practice Questions <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="profile-stats">
                <article class="profile-card profile-stat">
                    <p>Solved</p><strong id="solved-count">—</strong>
                </article>
                <article class="profile-card profile-stat">
                    <p>Total Questions</p><strong id="total-count">—</strong>
                </article>
                <article class="profile-card profile-stat">
                    <p>Remaining</p><strong id="remaining-count">—</strong>
                </article>
            </div>
            <article class="profile-card profile-panel">
                <div class="profile-progress-heading">
                    <h3>Overall Completion</h3>
                    <strong id="progress-percent">0%</strong>
                </div>
                <p id="progress-caption">Loading your progress…</p>
                <div class="profile-track"><div id="overall-progress" class="profile-fill"></div></div>
            </article>
            <article class="profile-card profile-panel">
                <h3>Topic-wise Progress</h3>
                <p class="profile-help">Your solved questions in each topic.</p>
                <div id="topic-progress" class="profile-topic-grid"><span>Loading topics…</span></div>
            </article>
            <p id="progress-error" class="profile-feedback" role="status"></p>
        </section>

        <section class="profile-section">
            <h2 class="profile-section-title">Account Settings</h2>
            <div class="profile-settings">
                <article class="profile-card profile-setting">
                    <h3><i class="fa-solid fa-user-pen"></i> Change Username</h3>
                    <p class="profile-help">Choose a unique username for your account.</p>
                    <form id="username-form">
                        <label for="new-username">New username</label>
                        <input id="new-username" type="text" minlength="3" maxlength="30" pattern="[A-Za-z0-9_-]{3,30}" value="{{user.username}}" required>
                        <small>3–30 characters: letters, numbers, _ and -</small>
                        <button type="submit">Save Username</button>
                        <p id="username-feedback" class="profile-feedback" role="status"></p>
                    </form>
                </article>
                <article class="profile-card profile-setting">
                    <h3><i class="fa-solid fa-lock"></i> Change Password</h3>
                    <p class="profile-help">Enter your current password to set a new one.</p>
                    <form id="password-form">
                        <label for="current-password">Current password</label>
                        <input id="current-password" type="password" maxlength="128" autocomplete="current-password" required>
                        <label for="new-password">New password</label>
                        <input id="new-password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
                        <label for="confirm-password">Confirm new password</label>
                        <input id="confirm-password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required>
                        <small>Use 12–128 characters.</small>
                        <button type="submit">Update Password</button>
                        <p id="password-feedback" class="profile-feedback" role="status"></p>
                    </form>
                </article>
            </div>
        </section>
        <footer class="profile-footer">Prep4Int · Keep learning, keep improving.</footer>
    </main>
    <script src="/js/profile.js" defer></script>
</body>
</html>